{% extends 'base.html.twig' %}

{% block title %}Scores - Reservation #{{ reservation.id }} - Bowlingcenter Brooklyn{% endblock %}

{% block body %}
    <section class="py-5">
        <div class="container">
            <div class="text-center mb-4">
                <i class="fa-solid fa-ranking-star text-warning" style="font-size: 3rem;"></i>
                <h1 class="mt-3 text-white">Scoreboard</h1>
                <p class="text-white">Reservation #{{ reservation.id }} &middot; {{ reservation.startTime|date('l, d F Y') }} &middot; Lane {{ reservation.lane }}</p>
            </div>

            {% if not score or score.value is empty %}
                <div class="alert alert-info text-center">
                    <i class="fa-solid fa-circle-info me-2"></i>No scores have been recorded for this reservation yet.
                </div>
            {% else %}
                {# Top scorer #}
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-warning text-dark">
                        <i class="fa-solid fa-trophy me-2"></i>Top Scorer
                    </div>
                    <div class="card-body text-center">
                        <h2 class="mb-1">{{ topScorer }}</h2>
                        <span class="fs-4 text-warning fw-bold">{{ playerTotals[topScorer] }} pts</span>
                    </div>
                </div>

                {# Overall totals #}
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <i class="fa-solid fa-chart-simple me-2"></i>Overall Totals
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-primary">
                                    <tr>
                                        <th>Rank</th>
                                        <th>Player</th>
                                        <th class="text-end">Total Score</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% set rank = 1 %}
                                    {% for name, total in playerTotals %}
                                        <tr{% if name == topScorer %} class="table-warning"{% endif %}>
                                            <td>
                                                {% if rank == 1 %}
                                                    <i class="fa-solid fa-medal text-warning"></i>
                                                {% elseif rank == 2 %}
                                                    <i class="fa-solid fa-medal text-secondary"></i>
                                                {% elseif rank == 3 %}
                                                    <i class="fa-solid fa-medal" style="color: #cd7f32;"></i>
                                                {% else %}
                                                    {{ rank }}
                                                {% endif %}
                                            </td>
                                            <td class="fw-semibold">{{ name }}</td>
                                            <td class="text-end fw-bold">{{ total }}</td>
                                        </tr>
                                        {% set rank = rank + 1 %}
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                {# Per-round scores #}
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <i class="fa-solid fa-list-ol me-2"></i>Scores Per Round
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-primary">
                                    <tr>
                                        <th>Round</th>
                                        {% for name in score.playerNames %}
                                            <th class="text-end">{{ name }}</th>
                                        {% endfor %}
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for i in 0..score.roundCount - 1 %}
                                        {% set round = score.getRound(i) %}
                                        <tr>
                                            <td class="fw-semibold">Round {{ i + 1 }}</td>
                                            {% for name in score.playerNames %}
                                                {% set isRoundBest = true %}
                                                {% for otherName, otherScore in round %}
                                                    {% if otherScore > round[name] %}
                                                        {% set isRoundBest = false %}
                                                    {% endif %}
                                                {% endfor %}
                                                <td class="text-end{% if isRoundBest %} fw-bold text-success{% endif %}">
                                                    {{ round[name] ?? '-' }}
                                                </td>
                                            {% endfor %}
                                        </tr>
                                    {% endfor %}
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <td class="fw-bold">Total</td>
                                        {% for name in score.playerNames %}
                                            <td class="text-end fw-bold">{{ playerTotals[name] }}</td>
                                        {% endfor %}
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            {% endif %}

            <div class="text-center mt-4">
                <a href="{{ path('app_reservation_confirmation', {id: reservation.id}) }}" class="btn btn-outline-light">
                    <i class="fa-solid fa-arrow-left me-1"></i>Back to Reservation
                </a>
            </div>
        </div>
    </section>
{% endblock %}
