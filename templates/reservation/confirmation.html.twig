{% extends 'base.html.twig' %}

{% block title %}Reservation Confirmed — Bowlingcenter Brooklyn{% endblock %}

{% block body %}
    <section class="py-5">
        <div class="container" style="max-width: 620px;">
            <div class="text-center mb-4">
                <i class="fa-solid fa-circle-check text-success" style="font-size: 3rem;"></i>
                <h1 class="mt-3">Reservation Placed!</h1>
                <p class="text-muted">Your reservation is pending confirmation. Here are the details:</p>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <i class="fa-solid fa-receipt me-2"></i>Reservation #{{ reservation.id }}
                </div>
                <div class="card-body">
                    <table class="table table-borderless mb-0">
                        <tr>
                            <td class="fw-semibold text-muted" style="width: 40%;"><i class="fa-solid fa-bowling-ball me-2"></i>Lane</td>
                            <td>{{ reservation.lane }}</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted"><i class="fa-regular fa-calendar-days me-2"></i>Date</td>
                            <td>{{ reservation.startTime|date('l, d F Y') }}</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted"><i class="fa-regular fa-clock me-2"></i>Time</td>
                            <td>{{ reservation.startTime|date('H:i') }} – {{ reservation.endTime|date('H:i') }}</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted"><i class="fa-solid fa-users me-2"></i>Players</td>
                            <td>
                                {{ reservation.numberOfAdults }} adult{{ reservation.numberOfAdults != 1 ? 's' : '' }}{% if reservation.numberOfChildren > 0 %}, {{ reservation.numberOfChildren }} child{{ reservation.numberOfChildren != 1 ? 'ren' : '' }}{% endif %}
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted"><i class="fa-solid fa-tag me-2"></i>Rate</td>
                            <td>&euro;{{ reservation.appliedRate|number_format(2) }} / hour ({{ reservation.tariff.name }})</td>
                        </tr>
                        {% if reservation.snackPackage %}
                            <tr>
                                <td class="fw-semibold text-muted"><i class="fa-solid fa-utensils me-2"></i>Snack Package</td>
                                <td>{{ reservation.snackPackage.name }} (&euro;{{ reservation.snackPackage.price|number_format(2) }})</td>
                            </tr>
                        {% endif %}
                        {% if reservation.partyPackage %}
                            <tr>
                                <td class="fw-semibold text-muted"><i class="fa-solid fa-champagne-glasses me-2"></i>Party Package</td>
                                <td>{{ reservation.partyPackage.name }} (&euro;{{ reservation.partyPackage.price|number_format(2) }})</td>
                            </tr>
                        {% endif %}
                    </table>
                </div>
                <div class="card-footer text-end">
                    <span class="fs-4 fw-bold text-primary">Total: &euro;{{ reservation.totalPrice|number_format(2) }}</span>
                </div>
            </div>

            <div class="text-center mt-4">
                <span class="badge bg-warning text-dark fs-6"><i class="fa-solid fa-hourglass-half me-1"></i>Status: Pending</span>
            </div>

            <div class="text-center mt-4">
                <a href="{{ path('app_home') }}" class="btn btn-outline-primary">
                    <i class="fa-solid fa-house me-2"></i>Back to Home
                </a>
            </div>
        </div>
    </section>
{% endblock %}
