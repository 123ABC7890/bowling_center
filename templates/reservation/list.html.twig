{% extends 'base.html.twig' %}

{% block title %}My Reservations - Bowlingcenter Brooklyn{% endblock %}

{% block body %}
    <section class="py-5">
        <div class="container">
            <h1 class="text-center mb-2 text-white"><i class="fa-solid fa-calendar-check me-2 text-primary"></i>My Reservations</h1>
            <p class="text-center text-white mb-4">View your upcoming and past reservations.</p>

            {% for flash in app.flashes('success') %}
                <div class="alert alert-success"><i class="fa-solid fa-circle-check me-2"></i>{{ flash }}</div>
            {% endfor %}
            {% for flash in app.flashes('danger') %}
                <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation me-2"></i>{{ flash }}</div>
            {% endfor %}

            {% set upcoming = [] %}
            {% set past = [] %}
            {% for r in reservations %}
                {% if r.startTime > now and r.status != constant('App\\Entity\\Reservation::STATUS_CANCELLED') %}
                    {% set upcoming = upcoming|merge([r]) %}
                {% else %}
                    {% set past = past|merge([r]) %}
                {% endif %}
            {% endfor %}

            <h4 class="mt-4 mb-3 text-white"><i class="fa-solid fa-clock me-2"></i>Upcoming</h4>
            {% if upcoming is empty %}
                <div class="alert alert-info">No upcoming reservations. <a href="{{ path('app_reservation_new') }}">Book a lane now!</a></div>
            {% else %}
                <div class="row g-3">
                    {% for r in upcoming %}
                        <div class="col-md-6 col-lg-4">
                            <div class="card shadow-sm h-100">
                                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                                    <span class="fw-semibold"><i class="fa-solid fa-bowling-ball me-2 text-primary"></i>{{ r.lane }}</span>
                                    {% if r.status == constant('App\\Entity\\Reservation::STATUS_CONFIRMED') %}
                                        <span class="badge bg-success">Confirmed</span>
                                    {% elseif r.status == constant('App\\Entity\\Reservation::STATUS_PENDING') %}
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    {% else %}
                                        <span class="badge bg-secondary">{{ r.status|capitalize }}</span>
                                    {% endif %}
                                </div>
                                <div class="card-body">
                                    <p class="mb-1"><i class="fa-regular fa-calendar-days me-2 text-muted"></i>{{ r.startTime|date('d/m/Y') }}</p>
                                    <p class="mb-1"><i class="fa-regular fa-clock me-2 text-muted"></i>{{ r.startTime|date('H:i') }} – {{ r.endTime|date('H:i') }}</p>
                                    <p class="mb-1"><i class="fa-solid fa-users me-2 text-muted"></i>{{ r.numberOfAdults }}A{% if r.numberOfChildren > 0 %} + {{ r.numberOfChildren }}C{% endif %}</p>
                                    <p class="mb-0 fw-bold"><i class="fa-solid fa-tag me-2 text-muted"></i>&euro;{{ r.totalPrice|number_format(2) }}</p>
                                </div>
                                <div class="card-footer bg-white d-flex gap-2">
                                    {% if r.score %}
                                        <a href="{{ path('app_reservation_score', {id: r.id}) }}" class="btn btn-sm btn-dark">
                                            <i class="fa-solid fa-ranking-star me-1"></i>Score
                                        </a>
                                    {% else %}
                                        <a class="btn btn-sm btn-dark disabled"><i class="fa-solid fa-ranking-star me-1"></i>Score</a>
                                    {% endif %}
                                    <form method="post" action="{{ path('app_reservation_cancel', {id: r.id}) }}" onsubmit="return confirm('Cancel this reservation?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('cancel-' ~ r.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fa-solid fa-xmark me-1"></i>Cancel
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            <h4 class="mt-5 mb-3 text-white"><i class="fa-solid fa-history me-2"></i>Past & Cancelled</h4>
            {% if past is empty %}
                <div class="alert alert-light text-muted">No past reservations yet.</div>
            {% else %}
                <div class="row g-3">
                    {% for r in past %}
                        <div class="col-md-6 col-lg-4">
                            <div class="card shadow-sm h-100{% if r.status == constant('App\\Entity\\Reservation::STATUS_CANCELLED') %} opacity-50{% endif %}">
                                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                                    <span class="fw-semibold"><i class="fa-solid fa-bowling-ball me-2 text-primary"></i>{{ r.lane }}</span>
                                    {% if r.status == constant('App\\Entity\\Reservation::STATUS_CANCELLED') %}
                                        <span class="badge bg-danger">Cancelled</span>
                                    {% elseif r.status == constant('App\\Entity\\Reservation::STATUS_CONFIRMED') %}
                                        <span class="badge bg-success">Confirmed</span>
                                    {% else %}
                                        <span class="badge bg-secondary">{{ r.status|capitalize }}</span>
                                    {% endif %}
                                </div>
                                <div class="card-body">
                                    <p class="mb-1"><i class="fa-regular fa-calendar-days me-2 text-muted"></i>{{ r.startTime|date('d/m/Y') }}</p>
                                    <p class="mb-1"><i class="fa-regular fa-clock me-2 text-muted"></i>{{ r.startTime|date('H:i') }} – {{ r.endTime|date('H:i') }}</p>
                                    <p class="mb-1"><i class="fa-solid fa-users me-2 text-muted"></i>{{ r.numberOfAdults }}A{% if r.numberOfChildren > 0 %} + {{ r.numberOfChildren }}C{% endif %}</p>
                                    <p class="mb-0 fw-bold"><i class="fa-solid fa-tag me-2 text-muted"></i>&euro;{{ r.totalPrice|number_format(2) }}</p>
                                </div>
                                {% if r.status != constant('App\\Entity\\Reservation::STATUS_CANCELLED') %}
                                    <div class="card-footer bg-white">
                                        {% if r.score %}
                                            <a href="{{ path('app_reservation_score', {id: r.id}) }}" class="btn btn-sm btn-dark">
                                                <i class="fa-solid fa-ranking-star me-1"></i>Score
                                            </a>
                                        {% else %}
                                            <a class="btn btn-sm btn-dark disabled"><i class="fa-solid fa-ranking-star me-1"></i>Score</a>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}
