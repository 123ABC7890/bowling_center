{% extends 'base.html.twig' %}

{% block title %}Reset Password — Bowlingcenter Brooklyn{% endblock %}

{% block body %}
    <section class="d-flex align-items-center justify-content-center">
        <div class="card shadow">
            <div class="card-header bg-primary text-white text-center py-3">
                <h4 class="mb-0"><i class="fa-solid fa-lock-open me-2"></i>Set New Password</h4>
            </div>
            <div class="card-body p-4">
                {% for flash in app.flashes('danger') %}
                    <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation me-2"></i>{{ flash }}</div>
                {% endfor %}

                <form method="post">
                    <div class="mb-3">
                        <label for="password" class="form-label fw-semibold">New Password</label>
                        <input type="password" name="password" id="password" class="form-control" required minlength="6">
                    </div>
                    <div class="mb-3">
                        <label for="confirm_password" class="form-label fw-semibold">Confirm Password</label>
                        <input type="password" name="confirm_password" id="confirm_password" class="form-control" required minlength="6">
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-check me-2"></i>Reset Password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </section>
{% endblock %}
