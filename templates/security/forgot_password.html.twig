{% extends 'base.html.twig' %}

{% block title %}Forgot Password — Bowlingcenter Brooklyn{% endblock %}

{% block body %}
    <section class="d-flex align-items-center justify-content-center" style="background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('{{ asset('images/hero-bg.png') }}') center/cover no-repeat; min-height: 80vh;">
        <div class="card shadow" style="width: 100%; max-width: 440px;">
            <div class="card-header bg-primary text-white text-center py-3">
                <h4 class="mb-0"><i class="fa-solid fa-key me-2"></i>Forgot Password</h4>
            </div>
            <div class="card-body p-4">
                {% for flash in app.flashes('success') %}
                    <div class="alert alert-success"><i class="fa-solid fa-circle-check me-2"></i>{{ flash }}</div>
                {% endfor %}
                {% for flash in app.flashes('danger') %}
                    <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation me-2"></i>{{ flash }}</div>
                {% endfor %}

                <p class="text-muted mb-3">Enter your email address and we'll send you a link to reset your password.</p>

                <form method="post">
                    <div class="mb-3">
                        <label for="email" class="form-label fw-semibold">Email</label>
                        <input type="email" name="email" id="email" class="form-control" required autofocus>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-paper-plane me-2"></i>Send Reset Link
                        </button>
                    </div>
                </form>

                <div class="text-center mt-3">
                    <a href="{{ path('app_login') }}">Back to login</a>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
