{% extends 'base.html.twig' %}

{% block title %}Register — Bowlingcenter Brooklyn{% endblock %}

{% block body %}
    <section class="d-flex align-items-center justify-content-center py-5" style="background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('{{ asset('images/hero-bg.png') }}') center/cover no-repeat; min-height: 85vh;">
        <div class="container" style="max-width: 520px;">
            <div class="text-center mb-4">
                <h1 class="display-5 fw-bold text-white">Create Account</h1>
                <p class="lead text-white-50">Sign up to start booking lanes</p>
            </div>

            <div class="card shadow">
                <div class="card-body p-4">
                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">
                                    <i class="fa-solid fa-user me-1"></i>First Name
                                </label>
                                {{ form_widget(form.firstName, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.firstName) }}
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Last Name</label>
                                {{ form_widget(form.lastName, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.lastName) }}
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fa-solid fa-envelope me-1"></i>Email
                            </label>
                            {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.email) }}
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fa-solid fa-phone me-1"></i>Phone
                                <small class="text-muted fw-normal">(optional)</small>
                            </label>
                            {{ form_widget(form.phone, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.phone) }}
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">
                                    <i class="fa-solid fa-lock me-1"></i>Password
                                </label>
                                {{ form_widget(form.plainPassword.first, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.plainPassword.first) }}
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Confirm Password</label>
                                {{ form_widget(form.plainPassword.second, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.plainPassword.second) }}
                            </div>
                        </div>

                        {{ form_errors(form.plainPassword) }}

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fa-solid fa-user-plus me-2"></i>Create Account
                            </button>
                        </div>

                    {{ form_end(form) }}
                </div>
            </div>

            <p class="text-center mt-4 text-white-50">
                Already have an account?
                <a href="{{ path('app_login') }}" class="fw-semibold text-white">Log in</a>
            </p>
        </div>
    </section>
{% endblock %}
