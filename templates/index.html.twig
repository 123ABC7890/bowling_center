{% extends 'base.html.twig' %}

{% block body %}
    <section class="hero text-center py-5 d-flex align-items-center justify-content-center" style="background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('{{ asset('images/hero-bg.png') }}') center/cover no-repeat; min-height: 60vh;">
        <div>
            <h1 class="display-4 fw-bold text-white">Welcome to Bowlingcenter Brooklyn</h1>
            <p class="lead text-white-50 mt-3">8 lanes, great packages, and fun for the whole family.</p>
            <a href="#" class="btn btn-primary btn-lg mt-3"><i class="fa-solid fa-bowling-ball me-2"></i>Reserve a Lane</a>
        </div>
    </section>

    <section class="py-5">
        <div class="container">
        <h2 class="text-center mb-4"><i class="fa-solid fa-tags me-2"></i>Our Tariffs</h2>
        <div class="row g-4 justify-content-center">
            <div class="col-md-4">
                <div class="card h-100 border-primary">
                    <div class="card-header bg-primary text-white text-center"><i class="fa-solid fa-calendar-days me-1"></i> Mon – Thu</div>
                    <div class="card-body text-center">
                        <p class="text-muted"><i class="fa-regular fa-clock me-1"></i>14:00 – 22:00</p>
                        <h3 class="card-title text-primary">&euro;24.00 <small class="fs-6 text-muted">/ hour</small></h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-primary">
                    <div class="card-header bg-primary text-white text-center"><i class="fa-solid fa-calendar-days me-1"></i> Fri – Sun Afternoon</div>
                    <div class="card-body text-center">
                        <p class="text-muted"><i class="fa-regular fa-clock me-1"></i>14:00 – 18:00</p>
                        <h3 class="card-title text-primary">&euro;28.00 <small class="fs-6 text-muted">/ hour</small></h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-primary">
                    <div class="card-header bg-primary text-white text-center"><i class="fa-solid fa-calendar-days me-1"></i> Fri – Sun Evening</div>
                    <div class="card-body text-center">
                        <p class="text-muted"><i class="fa-regular fa-clock me-1"></i>18:00 – 00:00</p>
                        <h3 class="card-title text-primary">&euro;33.50 <small class="fs-6 text-muted">/ hour</small></h3>
                    </div>
                </div>
            </div>
        </div>
        </div>
    </section>

    <section class="py-5">
        <div class="container">
        <h2 class="text-center mb-4"><i class="fa-solid fa-box-open me-2"></i>Packages</h2>
        <div class="row g-4">
            <div class="col-md-6">
                <h4 class="text-primary"><i class="fa-solid fa-utensils me-2"></i>Snack Packages</h4>
                <div class="card mb-3">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title mb-1">Basic</h5>
                            <p class="card-text text-muted mb-0">Chips, nuts, and soft drinks</p>
                        </div>
                        <span class="badge bg-secondary fs-6">&euro;15.00</span>
                    </div>
                </div>
                <div class="card">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title mb-1">Luxury</h5>
                            <p class="card-text text-muted mb-0">Nachos, wings, mini burgers &amp; drinks</p>
                        </div>
                        <span class="badge bg-secondary fs-6">&euro;35.00</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <h4 class="text-primary"><i class="fa-solid fa-party-horn me-2"></i>Party Packages</h4>
                <div class="card mb-3">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title mb-1"><i class="fa-solid fa-cake-candles me-1"></i> Children's Party</h5>
                            <p class="card-text text-muted mb-0">2h bowling, decorations, cake &amp; drinks</p>
                        </div>
                        <span class="badge bg-secondary fs-6">&euro;75.00</span>
                    </div>
                </div>
                <div class="card">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title mb-1"><i class="fa-solid fa-champagne-glasses me-1"></i> Bachelor Party</h5>
                            <p class="card-text text-muted mb-0">3h bowling, dedicated lane, snacks &amp; drinks</p>
                        </div>
                        <span class="badge bg-secondary fs-6">&euro;120.00</span>
                    </div>
                </div>
            </div>
        </div>
        </div>
    </section>

    <section class="text-center py-5 d-flex align-items-center justify-content-center" style="background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('{{ asset('images/magic-bowling.png') }}') center/cover no-repeat; min-height: 40vh;">
        <div class="container">
            <h2 class="display-5 fw-bold text-white mb-3"><i class="fa-solid fa-wand-magic-sparkles me-2"></i>Magic Bowling</h2>
            <p class="lead text-white-50">Disco-style bowling experience with neon lights and music</p>
            <p class="fs-5 text-white"><i class="fa-solid fa-calendar-days me-2"></i>Saturday – Sunday <span class="mx-2">|</span> <i class="fa-regular fa-clock me-2"></i>22:00 – 00:00</p>
            <a href="#" class="btn btn-outline-light btn-lg mt-2"><i class="fa-solid fa-bolt me-2"></i>Book Magic Bowling</a>
        </div>
    </section>

    <section class="py-5">
        <div class="container">
        <h2 class="text-center mb-4"><i class="fa-regular fa-clock me-2"></i>Opening Hours</h2>
        <div class="row justify-content-center">
            <div class="col-md-6">
                <table class="table table-striped text-center">
                    <tbody>
                        <tr>
                            <td class="fw-bold">Monday – Friday</td>
                            <td>14:00 – 22:00</td>
                        </tr>
                        <tr>
                            <td class="fw-bold">Saturday – Sunday</td>
                            <td>14:00 – 00:00</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        </div>
    </section>
{% endblock %}
