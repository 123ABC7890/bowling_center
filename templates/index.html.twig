{% extends 'base.html.twig' %}

{% block title %}Bowling Center — Home{% endblock %}

{% block body %}
    <section class="text-center py-5">
        <h1 class="display-4 fw-bold text-primary">Welcome to Bowling Center</h1>
        <p class="lead text-muted mt-3">8 lanes, great packages, and fun for the whole family.</p>
        <a href="#" class="btn btn-primary btn-lg mt-3">Reserve a Lane</a>
    </section>

    <section class="py-5">
        <h2 class="text-center mb-4">Our Tariffs</h2>
        <div class="row g-4 justify-content-center">
            <div class="col-md-4">
                <div class="card h-100 border-primary">
                    <div class="card-header bg-primary text-white text-center">Mon – Thu</div>
                    <div class="card-body text-center">
                        <p class="text-muted">14:00 – 22:00</p>
                        <h3 class="card-title text-primary">&euro;24.00 <small class="fs-6 text-muted">/ hour</small></h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-primary">
                    <div class="card-header bg-primary text-white text-center">Fri – Sun Afternoon</div>
                    <div class="card-body text-center">
                        <p class="text-muted">14:00 – 18:00</p>
                        <h3 class="card-title text-primary">&euro;28.00 <small class="fs-6 text-muted">/ hour</small></h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-primary">
                    <div class="card-header bg-primary text-white text-center">Fri – Sun Evening</div>
                    <div class="card-body text-center">
                        <p class="text-muted">18:00 – 00:00</p>
                        <h3 class="card-title text-primary">&euro;33.50 <small class="fs-6 text-muted">/ hour</small></h3>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-5">
        <h2 class="text-center mb-4">Packages</h2>
        <div class="row g-4">
            <div class="col-md-6">
                <h4 class="text-primary">Snack Packages</h4>
                <div class="card mb-3">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title mb-1">Basic</h5>
                            <p class="card-text text-muted mb-0">Chips, nuts, and soft drinks</p>
                        </div>
                        <span class="badge bg-secondary fs-6">&euro;15.00</span>
                    </div>
                </div>
                <div class="card">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title mb-1">Luxury</h5>
                            <p class="card-text text-muted mb-0">Nachos, wings, mini burgers &amp; drinks</p>
                        </div>
                        <span class="badge bg-secondary fs-6">&euro;35.00</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <h4 class="text-primary">Party Packages</h4>
                <div class="card mb-3">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title mb-1">Children's Party</h5>
                            <p class="card-text text-muted mb-0">2h bowling, decorations, cake &amp; drinks</p>
                        </div>
                        <span class="badge bg-secondary fs-6">&euro;75.00</span>
                    </div>
                </div>
                <div class="card">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title mb-1">Bachelor Party</h5>
                            <p class="card-text text-muted mb-0">3h bowling, dedicated lane, snacks &amp; drinks</p>
                        </div>
                        <span class="badge bg-secondary fs-6">&euro;120.00</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-5">
        <h2 class="text-center mb-4">Opening Hours</h2>
        <div class="row justify-content-center">
            <div class="col-md-6">
                <table class="table table-striped text-center">
                    <tbody>
                        <tr>
                            <td class="fw-bold">Monday – Friday</td>
                            <td>14:00 – 22:00</td>
                        </tr>
                        <tr>
                            <td class="fw-bold">Saturday – Sunday</td>
                            <td>14:00 – 00:00</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
{% endblock %}
