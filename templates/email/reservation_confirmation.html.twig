<h2>Reservation Confirmed — Bowlingcenter Brooklyn</h2>

<p>Dear {{ reservation.user ? reservation.user.firstName : reservation.name }},</p>

<p>Your reservation has been placed successfully. Here are the details:</p>

<table>
    <tr>
        <td>Reservation #</td>
        <td>{{ reservation.id }}</td>
    </tr>
    <tr>
        <td>Lane</td>
        <td>{{ reservation.lane }}</td>
    </tr>
    <tr>
        <td>Date</td>
        <td>{{ reservation.startTime|date('l, d F Y') }}</td>
    </tr>
    <tr>
        <td>Time</td>
        <td>{{ reservation.startTime|date('H:i') }} – {{ reservation.endTime|date('H:i') }}</td>
    </tr>
    <tr>
        <td>Players</td>
        <td>{{ reservation.numberOfAdults }} adult{{ reservation.numberOfAdults != 1 ? 's' : '' }}{% if reservation.numberOfChildren > 0 %}, {{ reservation.numberOfChildren }} child{{ reservation.numberOfChildren != 1 ? 'ren' : '' }}{% endif %}</td>
    </tr>
    <tr>
        <td>Rate</td>
        <td>&euro;{{ reservation.appliedRate|number_format(2) }}/hr ({{ reservation.tariff.name }})</td>
    </tr>
    {% if reservation.snackPackage %}
    <tr>
        <td>Snack Package</td>
        <td>{{ reservation.snackPackage.name }} (&euro;{{ reservation.snackPackage.price|number_format(2) }})</td>
    </tr>
    {% endif %}
    {% if reservation.partyPackage %}
    <tr>
        <td>Party Package</td>
        <td>{{ reservation.partyPackage.name }} (&euro;{{ reservation.partyPackage.price|number_format(2) }})</td>
    </tr>
    {% endif %}
    <tr>
        <td>Total</td>
        <td>&euro;{{ reservation.totalPrice|number_format(2) }}</td>
    </tr>
</table>

<p>Your reservation status is: <strong>{{ reservation.status|capitalize }}</strong></p>

<p>Thank you for choosing Bowlingcenter Brooklyn!</p>
