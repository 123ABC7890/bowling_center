{% extends 'base.html.twig' %}

{% block title %}My Profile - Bowlingcenter Brooklyn{% endblock %}

{% block body %}
    <section class="py-5">
        <div class="container">
            <h1 class="text-center mb-2"><i class="fa-solid fa-user me-2 text-primary"></i>My Profile</h1>
            <p class="text-center text-muted mb-4">Update your personal details.</p>

            {% for flash in app.flashes('success') %}
                <div class="alert alert-success"><i class="fa-solid fa-circle-check me-2"></i>{{ flash }}</div>
            {% endfor %}
            {% for flash in app.flashes('danger') %}
                <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation me-2"></i>{{ flash }}</div>
            {% endfor %}

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <i class="fa-solid fa-id-card me-2"></i>Personal Information
                </div>
                <div class="card-body">
                    {{ form_start(form) }}

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email</label>
                        <input type="email" class="form-control" value="{{ app.user.email }}" disabled>
                        <small class="text-muted">Email cannot be changed.</small>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">First Name</label>
                            {{ form_widget(form.firstName, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Last Name</label>
                            {{ form_widget(form.lastName, {'attr': {'class': 'form-control'}}) }}
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phone</label>
                        {{ form_widget(form.phone, {'attr': {'class': 'form-control'}}) }}
                    </div>

                    <div class="d-flex justify-content-between">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-floppy-disk me-2"></i>Save Changes
                        </button>
                        <a href="{{ path('app_logout') }}" class="btn btn-outline-danger">
                            <i class="fa-solid fa-right-from-bracket me-2"></i>Logout
                        </a>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
